# EditorConfig - Consistent formatting across editors
# https://editorconfig.org

root = true

# Default settings for all files
[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

# Python
[*.py]
indent_size = 4

# Rust
[*.rs]
indent_size = 4

# TypeScript and JavaScript
[*.{ts,tsx,js,jsx,mjs,cjs}]
indent_size = 2

# Makefile (must use tabs)
[Makefile]
indent_style = tab

# YAML
[*.{yml,yaml}]
indent_size = 2

# JSON
[*.json]
indent_size = 2

# Markdown
[*.md]
indent_size = 2
trim_trailing_whitespace = false

# Shell scripts
[*.sh]
indent_size = 2

# C/C++
[*.{c,h,cpp,hpp,cc,hh}]
indent_size = 4

# Go
[*.go]
indent_style = tab

# Lua
[*.lua]
indent_size = 2

# CSS
[*.css]
indent_size = 2

# HTML
[*.html]
indent_size = 2
